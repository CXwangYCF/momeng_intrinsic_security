# Set these paths for your machine. Use absolute paths.
MUSLR_DATA=/path/to/MuSLR
MUSLR_PROMPT_DIR=/path/to/MuSLR/prompts
RIPO_ROOT=/path/to/RIPO

# Use an OpenAI-compatible endpoint serving your vision-language model.
# "auto" discovers endpoints through a running RIPO service.
MUSLR_BASELINE_JSON_ENDPOINTS=http://127.0.0.1:22000/v1
MUSLR_LOGICAM_JSON_ENDPOINTS=http://127.0.0.1:22000/v1
MUSLR_BASELINE_JSON_MODEL=your-served-model-name
MUSLR_LOGICAM_JSON_MODEL=your-served-model-name
MUSLR_BASELINE_JSON_API_KEY=EMPTY
MUSLR_LOGICAM_JSON_API_KEY=EMPTY

# Default outputs go to myMuSLR/outputs. Override with an absolute path if needed.
# MUSLR_OUTPUT_DIR=/path/to/output-directory

MUSLR_BASELINE_JSON_IMAGE_URL_MODE=data
MUSLR_LOGICAM_JSON_IMAGE_URL_MODE=data
MUSLR_BASELINE_JSON_MAX_TOKENS=1024
MUSLR_LOGICAM_JSON_MAX_TOKENS=4096
MUSLR_BASELINE_JSON_WORKERS=2
MUSLR_LOGICAM_JSON_WORKERS=2
MUSLR_BASELINE_JSON_POOL_CONCURRENCY=2
MUSLR_LOGICAM_JSON_POOL_CONCURRENCY=2
MUSLR_BASELINE_JSON_TIMEOUT=180
MUSLR_LOGICAM_JSON_TIMEOUT=300

# Dashboard listens only on this machine by default.
MUSLR_JSON_DASHBOARD_HOST=127.0.0.1
MUSLR_JSON_DASHBOARD_PORT=5060
